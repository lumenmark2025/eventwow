{
  "name": "eventwow-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-seo.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:workspace": "node scripts/verify-workspace-v2.mjs",
    "test:admin": "node scripts/verify-admin-v2.mjs",
    "test:supplier": "node scripts/verify-supplier-v2.mjs",
    "test:supplier-workflows": "node scripts/verify-supplier-workflows-v2.mjs",
    "test:venue": "node scripts/verify-venue-v2.mjs",
    "test:customer": "node scripts/verify-customer-v2.mjs",
    "test:customer-supplier": "node --test scripts/verify-customer-supplier-workflow.mjs && node scripts/verify-workflow-browser.mjs",
    "test:quote-rls": "node scripts/verify-quote-rls.mjs",
    "test:public": "node --test scripts/verify-public-requests.mjs && node scripts/verify-public-v2.mjs",
    "test:public-profiles": "node scripts/verify-public-profiles-v2.mjs",
    "test:public-seo": "node scripts/verify-public-seo-contracts.mjs && node scripts/verify-public-seo-v2.mjs",
    "test:public-journey": "node scripts/verify-public-journey-contracts.mjs && node scripts/verify-public-journey-v2.mjs",
    "test:prerender-build": "node scripts/verify-prerender-build.mjs",
    "test:final-sweep": "node scripts/verify-public-seo-contracts.mjs && node scripts/verify-final-v2-sweep.mjs",
    "test:auth": "node scripts/verify-auth-contracts.mjs && node scripts/verify-auth-v2.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@supabase/supabase-js": "^2.90.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.45.0",
    "react": "^19.2.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "resend": "^6.9.2",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "autoprefixer": "^10.4.23",
    "axe-core": "4.13.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^7.2.4"
  }
}
